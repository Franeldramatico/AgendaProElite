<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    x:Class="AgendaProElite.Views.TaskPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodel="clr-namespace:AgendaProElite.ViewModels"
    x:DataType="viewmodel:TaskViewModel"
    Title="Tareas">

    <ContentPage.BindingContext>
        <viewmodel:TaskViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="10">
            <Label Grid.Column="0" Text="Tus Tareas" FontSize="20" FontAttributes="Bold" />
            <Label Grid.Column="1" Text="{Binding TotalPoints, StringFormat='Puntos: {0}'}" 
                 VerticalOptions="Center" />
        </Grid>

        <!-- Tasks List -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="10" Padding="10">
                <Label Text="Pendientes" FontAttributes="Bold" FontSize="16" />
                <CollectionView ItemsSource="{Binding Tasks}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="10" ColumnDefinitions="Auto,*,Auto,Auto">
                                <CheckBox Grid.Column="0" 
                                        IsChecked="{Binding IsCompleted}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:TaskViewModel}}, Path=CompleteTaskCommand}"
                                        CommandParameter="{Binding .}" />
                                <VerticalStackLayout Grid.Column="1" Margin="10,0">
                                    <Label Text="{Binding Title}" FontAttributes="Bold" />
                                    <Label Text="{Binding DueDate, StringFormat='Vence: {0:g}'}" 
                                         FontSize="12" TextColor="Gray" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding Points, StringFormat='{0} pts'}" 
                                     VerticalOptions="Center" />
                                <Button Grid.Column="3" Text="✕" 
                                      Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:TaskViewModel}}, Path=DeleteTaskCommand}"
                                      CommandParameter="{Binding .}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="Completadas" FontAttributes="Bold" FontSize="16" 
                     IsVisible="{Binding ShowCompleted}" />
                <CollectionView ItemsSource="{Binding CompletedTasks}" 
                              IsVisible="{Binding ShowCompleted}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="10" ColumnDefinitions="Auto,*,Auto">
                                <CheckBox Grid.Column="0" IsChecked="True" IsEnabled="False" />
                                <Label Grid.Column="1" Text="{Binding Title}" 
                                     TextDecorations="Strikethrough" TextColor="Gray" />
                                <Label Grid.Column="2" Text="{Binding Points, StringFormat='{0} pts'}" 
                                     VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <!-- FAB and Actions -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Padding="10">
            <Button Grid.Column="0" Text="Calcular Prioridades IA" 
                  Command="{Binding CalculateAIPrioritiesCommand}" />
            <Button Grid.Column="1" Text="+" 
                  WidthRequest="50" HeightRequest="50" CornerRadius="25"
                  Command="{Binding CreateTaskCommand}" />
        </Grid>
    </Grid>

</ContentPage>

