<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    x:Class="AgendaProElite.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodel="clr-namespace:AgendaProElite.ViewModels"
    x:DataType="viewmodel:MainViewModel"
    Title="AgendaPro Elite">

    <ContentPage.BindingContext>
        <viewmodel:MainViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,*">
        <Label 
            Text="AgendaPro Elite"
            FontSize="24"
            FontAttributes="Bold"
            HorizontalOptions="Center"
            Margin="0,20,0,10" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding NavigationItems}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Button Text="{Binding Title}" Command="{Binding NavigateCommand}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>

