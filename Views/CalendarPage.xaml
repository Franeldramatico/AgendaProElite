<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    x:Class="AgendaProElite.Views.CalendarPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodel="clr-namespace:AgendaProElite.ViewModels"
    x:DataType="viewmodel:CalendarViewModel"
    Title="Calendario">

    <ContentPage.BindingContext>
        <viewmodel:CalendarViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <!-- View Selector -->
        <HorizontalStackLayout Grid.Row="0" Spacing="10" Margin="10">
            <Button Text="Mes" Command="{Binding ChangeViewCommand}" CommandParameter="Month" />
            <Button Text="Semana" Command="{Binding ChangeViewCommand}" CommandParameter="Week" />
            <Button Text="Día" Command="{Binding ChangeViewCommand}" CommandParameter="Day" />
            <Button Text="Agenda" Command="{Binding ChangeViewCommand}" CommandParameter="Agenda" />
        </HorizontalStackLayout>

        <!-- Navigation -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" Margin="10">
            <Button Grid.Column="0" Text="&lt;" Command="{Binding PreviousPeriodCommand}" />
            <Label Grid.Column="1" Text="{Binding SelectedDate, StringFormat='{0:MMMM yyyy}'}" 
                   HorizontalOptions="Center" VerticalOptions="Center" />
            <Button Grid.Column="2" Text="&gt;" Command="{Binding NextPeriodCommand}" />
            <Button Grid.Column="1" Text="Hoy" Command="{Binding GoToTodayCommand}" 
                    HorizontalOptions="Center" VerticalOptions="End" />
        </Grid>

        <!-- Today's Events Summary -->
        <Border Grid.Row="2" Margin="10,5" Padding="10" StrokeThickness="1">
            <VerticalStackLayout>
                <Label Text="Eventos de Hoy" FontAttributes="Bold" />
                <CollectionView ItemsSource="{Binding TodayEvents}" HeightRequest="80">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="5">
                                <Label Text="{Binding Title}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>

        <!-- Calendar View -->
        <ScrollView Grid.Row="3">
            <CollectionView ItemsSource="{Binding Events}" SelectionMode="Single" 
                          SelectionChangedCommand="{Binding EditEventCommand}"
                          SelectionChangedCommandParameter="{Binding SelectedItem}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10" ColumnDefinitions="Auto,*,Auto">
                            <BoxView Grid.Column="0" WidthRequest="5" 
                                   Color="{Binding Color}" 
                                   VerticalOptions="Fill" />
                            <VerticalStackLayout Grid.Column="1" Margin="10,0">
                                <Label Text="{Binding Title}" FontAttributes="Bold" />
                                <Label Text="{Binding StartDate, StringFormat='{0:g}'}" 
                                     FontSize="12" TextColor="Gray" />
                                <Label Text="{Binding Description}" 
                                     FontSize="12" TextColor="Gray" 
                                     IsVisible="{Binding Description, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="2" Text="✕" 
                                  Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:CalendarViewModel}}, Path=DeleteEventCommand}"
                                  CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>

        <!-- FAB -->
        <Button Grid.Row="3" 
                Text="+" 
                FontSize="24"
                WidthRequest="60"
                HeightRequest="60"
                CornerRadius="30"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20"
                Command="{Binding CreateEventCommand}" />
    </Grid>

</ContentPage>

